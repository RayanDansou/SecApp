# ============================================
# SecApp - Variables d'Environnement
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_DB=secapp
POSTGRES_USER=secapp_user
POSTGRES_PASSWORD=secapp_password_CHANGE_ME
DATABASE_URL=postgresql://secapp_user:secapp_password_CHANGE_ME@database:5432/secapp

# ============================================
# DJANGO CONFIGURATION
# ============================================
# Générer une clé secrète avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-super-secret-key-CHANGE-ME-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# Security settings
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000
CORS_ALLOW_CREDENTIALS=True

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_ACCESS_TOKEN_LIFETIME=60  # minutes
JWT_REFRESH_TOKEN_LIFETIME=1440  # minutes (24 hours)

# ============================================
# AZURE OPENAI CONFIGURATION
# ============================================
# Azure OpenAI credentials
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-CHANGE-ME
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_MODEL=gpt-4o-mini

# ============================================
# RESEND EMAIL CONFIGURATION
# ============================================
RESEND_API_KEY=re_your_resend_api_key_CHANGE_ME
RESEND_FROM_EMAIL=SecApp <noreply@yourdomain.com>
RESEND_REPLY_TO=support@yourdomain.com

# Email notifications
SEND_EMAILS=True
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SecApp
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# MEDIA & STATIC FILES
# ============================================
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/static
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ============================================
# SECURITY SETTINGS
# ============================================
# File upload restrictions
ALLOWED_DOCUMENT_EXTENSIONS=pdf,docx,doc,txt
ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/msword,text/plain

# ============================================
# APPLICATION URLS
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Set to False in production
DJANGO_DEBUG=True
NODE_ENV=development

# ============================================
# DOCKER CONFIGURATION
# ============================================
COMPOSE_PROJECT_NAME=secapp

# ============================================
# OPTIONAL: SENTRY (Error Tracking)
# ============================================
# SENTRY_DSN=your-sentry-dsn-url
# SENTRY_ENVIRONMENT=development

# ============================================
# OPTIONAL: REDIS (Future Caching/Celery)
# ============================================
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0

# ============================================
# HEALTH CHECK
# ============================================
HEALTH_CHECK_ENABLED=True
