# ========================================
# SecApp - Environment Variables Template
# ========================================
# Copy this file to .env and fill in the values
# DO NOT commit .env to version control

# ========================================
# Django Backend Settings
# ========================================
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
LOG_LEVEL=INFO

# ========================================
# Database Settings (PostgreSQL)
# ========================================
DB_NAME=secapp
DB_USER=secapp_user
DB_PASSWORD=secapp_password
DB_HOST=db
DB_PORT=5432

# ========================================
# CORS Settings
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# ========================================
# Azure OpenAI Settings (Phase 4+)
# ========================================
# Get your API key from Azure Portal
AZURE_OPENAI_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/

# ========================================
# Resend Email Settings (Phase 8+)
# ========================================
# Get your API key from https://resend.com/
RESEND_API_KEY=re_your_resend_api_key_here

# ========================================
# Frontend Settings
# ========================================
NODE_ENV=production
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========================================
# Docker Ports (optional overrides)
# ========================================
FRONTEND_PORT=3000
BACKEND_PORT=8000
# DB_PORT=5432

# ========================================
# Notes:
# ========================================
# 1. Generate a secure DJANGO_SECRET_KEY:
#    python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
#
# 2. For production, set DEBUG=False
#
# 3. Azure OpenAI and Resend keys are optional for Phase 0-3
#    They will be needed starting from Phase 4 (AI) and Phase 8 (Emails)
#
# 4. Update ALLOWED_HOSTS for production with your domain
#
# 5. Use strong passwords for DB_PASSWORD in production